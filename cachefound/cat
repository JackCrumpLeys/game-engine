/// System parameter for queueing render operations.
/// Uses a thread-local queue — zero contention, fully parallel.
pub struct RenderOps<'w> {
    queue: TLResMut<'w, ThreadLocalRenderQueue>,
}

impl<'w> SystemParam for RenderOps<'w> {
    type State = <TLResMut<'static, ThreadLocalRenderQueue> as SystemParam>::State;
    type Item<'a> = RenderOps<'a>;

    const DYNAMIC: bool = false;

    fn init_state(world: &mut World, access: &mut SystemAccess) -> Self::State {
        world.thread_local_res_mut().get_or_insert_default::<ThreadLocalRenderQueue>();
        world.resources_mut().get_or_insert_default::<RenderStackStore>();
        TLResMut::<ThreadLocalRenderQueue>::init_state(world, access)
    }

    unsafe fn get_param<'a>(
        state: &'a mut Self::State,
        world: &'a UnsafeWorldCell<'a>,
    ) -> Self::Item<'a> {
        RenderOps {
            queue: unsafe { TLResMut::get_param(state, world) },
        }
    }
}

impl<'w> RenderOps<'w> {
    /// Start building a new entity's render stack (full rebuild).
    pub fn entity(&mut self, entity: Entity) -> EntityStackBuilder<'_> {
        EntityStackBuilder {
            queue: &mut self.queue,
            entity,
            ops: SmallVec::new(),
        }
    }

    /// Patch specific shapes in an existing entity's stack.
    /// Only the patched channels get marked dirty — untouched channels stay clean.
    pub fn patch_entity(&mut self, entity: Entity) -> PatchBuilder<'_> {
        PatchBuilder {
            queue: &mut self.queue,
            entity,
            stack_idx: 0,
            patches: SmallVec::new(),
        }
    }

    /// Free an entity's render stack (despawn).
    pub fn free(&mut self, entity: Entity) {
        self.queue.push(RenderOp::Free { entity, stack_idx: 0 });
    }
}

// ── Full stack builder ───────────────────────────────────────────────

pub struct EntityStackBuilder<'a> {
    queue: &'a mut ThreadLocalRenderQueue,
    entity: Entity,
    ops: SmallVec<Shape, 8>,
}

impl<'a> EntityStackBuilder<'a> {
    pub fn push(mut self, shape: Shape) -> Self {
        self.ops.push(shape);
        self
    }

    pub fn circle(self, p: GpuCirclePacket) -> Self            { self.push(Shape::Circle(p)) }
    pub fn rect(self, p: GpuRectPacket) -> Self                { self.push(Shape::Rect(p)) }
    pub fn triangle(self, p: GpuTrianglePacket) -> Self        { self.push(Shape::Triangle(p)) }
    pub fn rounded_rect(self, p: GpuRoundedRectPacket) -> Self { self.push(Shape::RoundedRect(p)) }
    pub fn line_segment(self, p: GpuLineSegmentPacket) -> Self { self.push(Shape::LineSegment(p)) }
    pub fn sprite(self, p: GpuSpritePacket) -> Self            { self.push(Shape::Sprite(p)) }
    pub fn stroke(self, p: GpuStrokePacket) -> Self            { self.push(Shape::Stroke(p)) }
    pub fn clip_rect(self, p: GpuClipRectPacket) -> Self       { self.push(Shape::ClipRect(p)) }
    pub fn linear_gradient(self, p: GpuLinearGradientPacket) -> Self  { self.push(Shape::LinearGradient(p)) }
    pub fn radial_gradient(self, p: GpuRadialGradientPacket) -> Self  { self.push(Shape::RadialGradient(p)) }
    pub fn glyph(self, p: GpuGlyphPacket) -> Self              { self.push(Shape::Glyph(p)) }

    /// Finalise and push to the thread-local queue.
    pub fn spawn(self) {
        self.queue.push(RenderOp::Stacked {
            entity: self.entity,
            ops: self.ops,
        });
    }
}

// ── Patch builder ────────────────────────────────────────────────────

pub struct PatchBuilder<'a> {
    queue: &'a mut ThreadLocalRenderQueue,
    entity: Entity,
    stack_idx: u8,
    patches: SmallVec<(u8, Shape), 4>,
}

impl<'a> PatchBuilder<'a> {
    /// Set which stack index to patch (default 0).
    pub fn stack(mut self, idx: u8) -> Self {
        self.stack_idx = idx;
        self
    }

    /// Update the shape at `op_offset` in the stack.
    /// Only this shape's channel gets marked dirty.
    pub fn update(mut self, op_offset: u8, shape: Shape) -> Self {
        self.patches.push((op_offset, shape));
        self
    }

    /// Submit the patches.
    pub fn apply(self) {
        if !self.patches.is_empty() {
            self.queue.push(RenderOp::Patch {
                entity: self.entity,
                stack_idx: self.stack_idx,
                patches: self.patches,
            });
        }
    }
}
//! Shape marker types and StackPattern trait for typed render stack access.
//!
//! Each marker maps to a GPU packet type and shape index. `StackPattern` is
//! implemented for tuples of markers to compute bitmasks and default shapes.

use game_engine_shaders_types::packet::*;
use smallvec::SmallVec;

// ── StackShape trait ─────────────────────────────────────────────────

/// Maps a marker type to its GPU packet type and shape index.
pub trait StackShape {
    type Packet: GpuPacket + Default;
    const SHAPE_INDEX: u32;

    /// Wrap a packet into the `Shape` enum.
    fn wrap(packet: Self::Packet) -> Shape;

    /// Extract a shared reference from a `Shape` enum, if it matches.
    fn unwrap_ref(shape: &Shape) -> Option<&Self::Packet>;

    /// Extract a mutable reference from a `Shape` enum, if it matches.
    fn unwrap_mut(shape: &mut Shape) -> Option<&mut Self::Packet>;
}

// ── Marker types ─────────────────────────────────────────────────────

macro_rules! impl_stack_shape {
    ($(($_index:expr, $SHAPE_INDEX:ident, $_p:ident, $_s:ident, $ShapeType:ident, $GpuPacket:ident)),*) => {
        $(
            pub struct $ShapeType;

            impl StackShape for $ShapeType {
                type Packet = $GpuPacket;
                const SHAPE_INDEX: u32 = $SHAPE_INDEX;

                #[inline]
                fn wrap(packet: Self::Packet) -> Shape {
                    Shape::$ShapeType(packet)
                }

                #[inline]
                fn unwrap_ref(shape: &Shape) -> Option<&Self::Packet> {
                    match shape {
                        Shape::$ShapeType(p) => Some(p),
                        _ => None,
                    }
                }

                #[inline]
                fn unwrap_mut(shape: &mut Shape) -> Option<&mut Self::Packet> {
                    match shape {
                        Shape::$ShapeType(p) => Some(p),
                        _ => None,
                    }
                }
            }
        )*
    };
}

game_engine_shaders_types::for_all_shapes!(impl_stack_shape);

// ── StackPattern trait ───────────────────────────────────────────────

/// Describes a pattern of shapes that a render stack should contain.
/// Implemented for tuples of `StackShape` markers.
pub trait StackPattern: 'static + Send + Sync {
    /// Combined bitmask of all shapes in this pattern.
    fn bitmask() -> u32;

    /// Number of shapes in this pattern.
    fn len() -> usize;

    /// Generate default shapes for stack creation.
    fn default_shapes() -> SmallVec<Shape, 8>;

    /// Shape indices in order.
    fn shape_indices() -> SmallVec<u32, 8>;
}

// ── Tuple impls via macro ────────────────────────────────────────────

macro_rules! impl_stack_pattern {
    ($($T:ident),+) => {
        impl<$($T: StackShape + std::marker::Send + std::marker::Sync + 'static),+> StackPattern for ($($T,)+) {
            #[inline]
            fn bitmask() -> u32 {
                0 $(| (1u32 << $T::SHAPE_INDEX))+
            }

            #[inline]
            fn len() -> usize {
                impl_stack_pattern!(@count $($T),+)
            }

            fn default_shapes() -> SmallVec<Shape, 8> {
                let mut v = SmallVec::new();
                $(v.push($T::wrap($T::Packet::default()));)+
                v
            }

            fn shape_indices() -> SmallVec<u32, 8> {
                let mut v = SmallVec::new();
                $(v.push($T::SHAPE_INDEX);)+
                v
            }
        }
    };

    // Count helper
    (@count $head:ident $(, $tail:ident)*) => {
        1 + impl_stack_pattern!(@count $($tail),*)
    };
    (@count) => { 0 };
}

// Generate impls for tuple sizes 1–8
impl_stack_pattern!(A);
impl_stack_pattern!(A, B);
impl_stack_pattern!(A, B, C);
impl_stack_pattern!(A, B, C, D);
impl_stack_pattern!(A, B, C, D, E);
impl_stack_pattern!(A, B, C, D, E, F);
impl_stack_pattern!(A, B, C, D, E, F, G);
impl_stack_pattern!(A, B, C, D, E, F, G, H);
use game_engine_shaders_types::packet::NUM_SHAPE_KINDS;

pub type StackId = u32;

pub struct GpuSlotAllocator {
    /// High-water mark for allocated stack IDs (= GPU entity head count)
    pub stack_count: u32,
    /// Stack IDs that were freed and can be reused
    pub free_stack_ids: Vec<StackId>,

    /// High-water mark per shape kind (number of allocated slots in primitive buffers)
    pub max_slots: Vec<u32>,
    /// Free-lists per shape kind for recycling slots
    pub free_lists: Vec<Vec<u32>>,

    /// Free lists for op_pool ranges grouped by length (up to length 16)
    pub free_op_pool: Vec<Vec<u32>>,

    /// Per-channel dirty slot indices for incremental GPU upload
    pub dirty_slots: Vec<Vec<u32>>,
    /// Stack IDs with dirty entity heads (e.g. position changed)
    pub dirty_entity_heads: Vec<StackId>,
}

impl Default for GpuSlotAllocator {
    fn default() -> Self {
        Self {
            stack_count: 0,
            free_stack_ids: Vec::new(),
            max_slots: vec![0; NUM_SHAPE_KINDS],
            free_lists: (0..NUM_SHAPE_KINDS).map(|_| Vec::new()).collect(),
            free_op_pool: (0..16).map(|_| Vec::new()).collect(),
            dirty_slots: (0..NUM_SHAPE_KINDS).map(|_| Vec::new()).collect(),
            dirty_entity_heads: Vec::new(),
        }
    }
}

impl GpuSlotAllocator {
    pub fn new() -> Self {
        Self::default()
    }

    /// Allocates a StackId (index into the GpuEntityHead buffer).
    /// Reuses IDs from the free list if available.
    pub fn alloc_stack_id(&mut self) -> StackId {
        if let Some(id) = self.free_stack_ids.pop() {
            id
        } else {
            let id = self.stack_count;
            self.stack_count += 1;
            id
        }
    }

    /// Returns a StackId to the pool for reuse.
    pub fn free_stack_id(&mut self, id: StackId) {
        self.free_stack_ids.push(id);
    }

    /// Allocates a slot in a specific primitive channel (e.g., Circle or Rect).
    pub fn alloc_slot(&mut self, shape_kind: u32) -> u32 {
        let kind = shape_kind as usize;
        if let Some(slot) = self.free_lists[kind].pop() {
            slot
        } else {
            let slot = self.max_slots[kind];
            self.max_slots[kind] += 1;
            slot
        }
    }

    /// Bulk allocates multiple StackIds.
    pub fn alloc_stack_ids(&mut self, count: u32) -> Vec<StackId> {
        let mut ids = Vec::with_capacity(count as usize);
        for _ in 0..count {
            ids.push(self.alloc_stack_id());
        }
        ids
    }

    /// Bulk allocates multiple slots for a specific shape kind.
    pub fn alloc_slots(&mut self, shape_kind: u32, count: u32) -> Vec<u32> {
        let mut slots = Vec::with_capacity(count as usize);
        for _ in 0..count {
            slots.push(self.alloc_slot(shape_kind));
        }
        slots
    }

    /// Returns a primitive slot to the pool for reuse.
    pub fn free_slot(&mut self, shape_kind: u32, slot: u32) {
        self.free_lists[shape_kind as usize].push(slot);
    }

    /// Allocates a range of op_pool if a previously freed one of the same size exists.
    pub fn alloc_op_pool_range(&mut self, len: u32) -> Option<u32> {
        let len = len as usize;
        if len < self.free_op_pool.len() {
            self.free_op_pool[len].pop()
        } else {
            None
        }
    }

    /// Recycles a range of op_pool.
    pub fn free_op_pool_range(&mut self, start: u32, len: u32) {
        let len = len as usize;
        if len < self.free_op_pool.len() {
            self.free_op_pool[len].push(start);
        }
    }

    /// Marks a specific slot in a primitive channel as dirty (needs GPU upload).
    pub fn mark_dirty(&mut self, shape_kind: u32, slot: u32) {
        self.dirty_slots[shape_kind as usize].push(slot);
    }

    /// Marks an entity head (stack) as dirty (needs GPU position/offset upload).
    pub fn mark_entity_head_dirty(&mut self, _stack_id: StackId) {
        // No-op. The entire buffer is synced each frame because entity count changes,
        // and identifying dirty spans isn't currently used by the uploader for entity heads.
    }

    /// Drains the dirty tracking lists. Used by the renderer to perform incremental updates.
    pub fn take_dirty(&mut self) -> Vec<Vec<u32>> {
        self.dirty_entity_heads.clear();
        let mut result = (0..NUM_SHAPE_KINDS).map(|_| Vec::new()).collect::<Vec<_>>();
        for (i, slots) in self.dirty_slots.iter_mut().enumerate() {
            if !slots.is_empty() {
                slots.sort_unstable();
                slots.dedup();
                std::mem::swap(&mut result[i], slots);
            }
        }
        result
    }
}
