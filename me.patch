+// ── Per-Test Animation Logic ─────────────────────────────────────────
+
+pub fn animate_grid_system(mut query: Query<(&GridItem, &mut GridShape)>, time: Res<SimTime>) {
+    let phase = time.phase;
+    query.for_each_par_mut(|(item, mut shape)| {
+        let wave_x = (phase + item.base_y * 0.02).sin() * 15.0;
+        let wave_y = (phase + item.base_x * 0.02).cos() * 15.0;
+        *shape.position_mut() = vec2(item.base_x + wave_x, item.base_y + wave_y);
+    });
+}
+
+pub fn animate_giant_system(mut query: Query<(&GiantItem, &mut GiantShape)>, time: Res<SimTime>) {
+    let phase = time.phase;
+    query.for_each_par_mut(|(item, mut shape)| {
+        let x = (phase * 0.5 + item.phase_offset).sin() * 200.0;
+        let y = (phase * 0.7 + item.phase_offset).cos() * 200.0;
+        *shape.position_mut() = vec2(x, y);
+    });
+}
