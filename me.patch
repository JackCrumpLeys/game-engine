+// ── Constant ECS Churn Spawner ───────────────────────────────────────
+
+pub fn churn_system(
+    state: Res<SuiteState>,
+    mut allocator: ResMut<GpuSlotAllocator>,
+    mut packet: ResMut<RenderPacket>,
+    font: Res<FontAtlas>,
+    commands: Commands,
+    query: Query<(Entity, &ChurnItem)>,
+) {
+    if state.current_test != 2 || state.completed || state.test_start.is_none() {
+        return;
+    }
+
+    let current_time = state.test_start.unwrap().elapsed().as_secs_f32();
+    let op_pool = Arc::make_mut(&mut packet.op_pool);
+    let mut rng = rand::rng();
+    let glyph_chars: Vecassistant = font.atlas.glyphs.keys().cloned().collect();
+
+    // 1. Despawn old entities (live for exactly 0.5 seconds)
+    query.for_each(|(e, item)| {
+        if current_time - item.spawn_time > 0.5 {
+            commands.despawn(e);
+        }
+    });
+
+    // 2. Spawn 500 new entities EVERY SINGLE FRAME
+    for _ in 0..500 {
+        let ch = *glyph_chars.choose(&mut rng).unwrap_or(&'X');
+        let alloc = ChurnShape::spawn_alloc(&mut allocator, op_pool);
+        let mut shape = ChurnShape::default();
+
+        let rx = rng.random_range(-800.0..800.0);
+        let ry = rng.random_range(-500.0..500.0);
+        *shape.position_mut() = vec2(rx, ry);
+
+        if let Some(metrics) = font.atlas.glyphs.get(&ch) {
+            let mut g = GpuGlyphPacket::default();
+            g.scale = 24.0 / font.atlas.units_per_em;
+            g.line_start = metrics.line_start;
+            g.line_count = metrics.line_count;
+            g.bbox_min = metrics.bbox_min;
+            g.bbox_max = metrics.bbox_max;
+            g.color = ColorRGBA::new(rng.random(), rng.random(), rng.random(), 1.0);
+            *shape.glyph_mut() = g;
+        }
+
+        commands.spawn((
+            Position { x: rx, y: ry },
+            ChurnItem {
+                spawn_time: current_time,
+            },
+            alloc,
+            shape,
+        ));
+    }
+}
