+// ── Orchestrator ─────────────────────────────────────────────────────
+
+pub fn test_orchestrator(
+    mut state: ResMut<SuiteState>,
+    mut allocator: ResMut<GpuSlotAllocator>,
+    mut packet: ResMut<RenderPacket>,
+    font: Res<FontAtlas>,
+    commands: Commands,
+    grid_q: Query<(Entity, &GridItem)>,
+    giant_q: Query<(Entity, &GiantItem)>,
+    churn_q: Query<(Entity, &ChurnItem)>,
+) {
+    if state.completed {
+        return;
+    }
+
+    let now = Instant::now();
+
+    // Setup new test if needed
+    if state.test_start.is_none() {
+        state.test_start = Some(now);
+        state.frames = 0;
+
+        let op_pool = Arc::make_mut(&mut packet.op_pool);
+        let mut rng = rand::rng();
+        let glyph_chars: Vecassistant = font.atlas.glyphs.keys().cloned().collect();
+
+        match state.current_test {
+            0 => {
+                log::info!("Starting Test 0: Mass Micro-Glyphs (160,000 entities)");
+                let rows = 400;
+                let cols = 400;
+                let spacing = 12.0;
+                let offset_x = (cols as f32 * spacing) / 2.0;
+                let offset_y = (rows as f32 * spacing) / 2.0;
+
+                for r in 0..rows {
+                    for c in 0..cols {
+                        let base_x = c as f32 * spacing - offset_x;
+                        let base_y = r as f32 * spacing - offset_y;
+                        let ch = *glyph_chars.choose(&mut rng).unwrap_or(&'A');
+
+                        let alloc = GridShape::spawn_alloc(&mut allocator, op_pool);
+                        let mut shape = GridShape::default();
+                        *shape.position_mut() = vec2(base_x, base_y);
+
+                        if let Some(metrics) = font.atlas.glyphs.get(&ch) {
+                            let mut g = GpuGlyphPacket::default();
+                            g.scale = 10.0 / font.atlas.units_per_em;
+                            g.line_start = metrics.line_start;
+                            g.line_count = metrics.line_count;
+                            g.bbox_min = metrics.bbox_min;
+                            g.bbox_max = metrics.bbox_max;
+                            g.color = ColorRGBA::new(0.0, 1.0, 0.8, 1.0);
+                            *shape.glyph_mut() = g;
+                        }
+
+                        commands.spawn((
+                            Position {
+                                x: base_x,
+                                y: base_y,
+                            },
+                            GridItem { base_x, base_y },
+                            alloc,
+                            shape,
+                        ));
+                    }
+                }
+            }
+            1 => {
+                log::info!("Starting Test 1: Giant Overlapping ALU Test (250 entities)");
+                for i in 0..250 {
+                    let ch = *glyph_chars.choose(&mut rng).unwrap_or(&'W');
+                    let alloc = GiantShape::spawn_alloc(&mut allocator, op_pool);
+                    let mut shape = GiantShape::default();
+
+                    if let Some(metrics) = font.atlas.glyphs.get(&ch) {
+                        let mut g = GpuGlyphPacket::default();
+                        g.scale = 600.0 / font.atlas.units_per_em; // MASSIVE
+                        g.line_start = metrics.line_start;
+                        g.line_count = metrics.line_count;
+                        g.bbox_min = metrics.bbox_min;
+                        g.bbox_max = metrics.bbox_max;
+                        // Highly transparent so the GPU is forced to blend and calculate every pixel
+                        g.color = ColorRGBA::new(1.0, 0.2, 0.5, 0.05);
+                        *shape.glyph_mut() = g;
+                    }
+
+                    commands.spawn((
+                        Position { x: 0.0, y: 0.0 },
+                        GiantItem {
+                            phase_offset: i as f32 * 0.1,
+                        },
+                        alloc,
+                        shape,
+                    ));
+                }
+            }
+            2 => {
+                log::info!("Starting Test 2: Extreme ECS & Memory Churn");
+            }
+            _ => {
+                state.completed = true;
+                log::info!("ALL TESTS COMPLETED! Final rating: {}", state.report);
+                return;
+            }
+        }
+        return;
+    }
+
+    let elapsed = now.duration_since(state.test_start.unwrap()).as_secs_f32();
+    state.frames += 1;
+
+    // Transition test after 10 seconds
+    if elapsed >= 10.0 {
+        let avg_fps = state.frames as f32 / elapsed;
+        let rating = get_rating(avg_fps);
+        state.report = format!(
+            "Test {} Avg FPS: {:.1} [{}]",
+            state.current_test, avg_fps, rating
+        );
+        log::info!("{}", state.report);
+
+        // Nuke all test entities
+        grid_q.for_each(|(e, _)| commands.despawn(e));
+        giant_q.for_each(|(e, _)| commands.despawn(e));
+        churn_q.for_each(|(e, _)| commands.despawn(e));
+
+        state.current_test += 1;
+        state.test_start = None; // Trigger next setup
+    }
+}
